[Unit]
Description=Pentaho Language Pack Installer REST API
After=network.target

[Service]
Type=notify
User=pentaho
Group=pentaho
WorkingDirectory=/opt/pentaho/pentaho-server/pentaho-solutions/system/languagePackInstaller/python
Environment="PLUGIN_DIR=/opt/pentaho/pentaho-server/pentaho-solutions/system/languagePackInstaller"
Environment="PENTAHO_BASE_DIR=/opt/pentaho/pentaho-server"
Environment="PORT=5000"
ExecStart=/usr/bin/gunicorn -w 4 -b 127.0.0.1:5000 --timeout 300 api:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
PrivateTmp=true
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
